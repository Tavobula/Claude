# Copie a .env, complete y NUNCA lo suba al repositorio.
DOMINIO=portafolio.ejemplo.com
POSTGRES_PASSWORD=cambie-esta-clave-por-una-larga-y-aleatoria

# Proveedor de identidad (OIDC): Auth0, Keycloak, Entra ID, Cognito, Google...
PORTAFOLIO_OIDC_EMISOR=https://su-proveedor.ejemplo.com/
PORTAFOLIO_OIDC_AUDIENCIA=https://portafolio.ejemplo.com/api
# Opcional: si se omite se descubre en <emisor>/.well-known/openid-configuration
PORTAFOLIO_OIDC_JWKS_URL=

PORTAFOLIO_POLITICA_VERSION=2026-09
# Orígenes del frontend web que llamará a la API, separados por coma
PORTAFOLIO_CORS_ORIGENES=
DIAS_RETENCION_RESPALDOS=30
